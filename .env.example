# Sitenin yayında olacağı tam adres (SEO metadata, sitemap ve OG görselleri için kullanılır)
NEXT_PUBLIC_SITE_URL=https://www.zambakyemek.com

# İletişim formu e-posta gönderimi (Resend — https://resend.com)
# Tanımlı değilse form, kullanıcıya "şu anda yapılandırılıyor" mesajı gösterir.
RESEND_API_KEY=

# İletişim formu mesajlarının iletileceği adres (tanımlı değilse lib/data.ts içindeki COMPANY.email kullanılır)
CONTACT_TO_EMAIL=info@zambakyemek.com

# Resend üzerinde doğrulanmış gönderen adresi (kendi alan adınızı Resend'de doğrulamadan
# önce varsayılan olarak onboarding@resend.dev kullanılabilir)
CONTACT_FROM_EMAIL="Zambak Yemek Web Sitesi <onboarding@resend.dev>"
